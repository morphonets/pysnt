          "params": [],
          "return_type": "int",
          "java_return_type": "long",
          "return_description": "the cache directory's size in bytes, or 0 if it could not be read",
          "throws": {}
        }
      ],
      "documentation": "Java method: static getCacheDirSize",
      "javadoc_description": "Computes the on-disk size of getCacheDir(). This walks the whole cache tree, so it can be slow once many files have accumulated; avoid calling this on the EDT",
