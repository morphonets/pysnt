              "java_type": "double",
              "description": "",
              "javadoc_name": "param_1"
            }
          ],
          "return_type": "List[int]",
          "java_return_type": "int[]",
          "return_description": "array of indices into `profile` where minima were found",
          "throws": {}
        }
      ],
      "documentation": "Java method: findMinima1D",
      "javadoc_description": "Finds local minima in a 1D profile using prominence-based filtering. Symmetric inversion of `findMaxima1D(float[], double)`: a sample is a local minimum if it is strictly less than both its neighbors (ignoring NaN) and its prominence (the height it would need to climb to escape the basin and reach a deeper minimum, or the profile boundary) exceeds the threshold.\n\nUseful for detecting localized intensity valleys along a path's intensity profile -- the inverse of finding peaks.",
      "category": "Utilities",
      "deprecated": false,
      "since_version": null,
      "see_also": [],
      "examples": []
    },
