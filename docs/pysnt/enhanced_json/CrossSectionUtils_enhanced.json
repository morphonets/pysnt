      "documentation": "Java method: findMaxima1D",
      "javadoc_description": "Finds local maxima in a 1D profile using prominence-based filtering. A sample is a local maximum if it is strictly greater than both its neighbors (ignoring NaN) and its prominence exceeds the threshold. Prominence is defined as the peak value minus the highest saddle point connecting the peak to any higher peak (or the profile boundary).",
      "category": "Utilities",
      "deprecated": false,
      "since_version": null,
      "see_also": [],
      "examples": []
    },
