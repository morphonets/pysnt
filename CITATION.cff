    given-names: Tiago A.
    orcid: "https://orcid.org/0000-0001-6866-1540"
    affiliation: "Janelia Research Campus, Howard Hughes Medical Institute"
  - name: "PySNT contributors"
  - name: "SNT contributors"
license: GPL-3.0-or-later
